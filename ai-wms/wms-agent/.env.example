# =====================================================================
#  AI-WMS Agent 服务配置示例
#  使用：复制为 .env 并填入实际值
# =====================================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=ai_wms

# ---------- Java 业务服务 ----------
JAVA_BASE_URL=http://localhost:8080/api

# ---------- LLM（可选）----------
# 不配置也能跑——系统会自动降级为规则桩
#
# 通义千问（DashScope）：
#   1. 访问 https://bailian.console.aliyun.com/ 开通并创建 API Key
#   2. 格式：sk-xxxxxxxx
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 也可以换成 DeepSeek（更便宜）：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
# 或智谱 GLM：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
