# =====================================================================
#  AI-WMS 环境变量模板（三个服务共用）
#
#  用法：复制成 .env.local 并填入真实值。
#        .env.local 已被 gitignore，**不要提交**。
#
#    bash / Git Bash：
#        set -a && source ai-wms/.env.local && set +a
#        cd ai-wms/wms-backend && mvn -o spring-boot:run
#
#    Windows：start-all.bat 会自动读取 .env.local
#
#  为什么抽出来：
#    配置文件要提交到公开仓库，写进去的密码/密钥等于公开。
#    JWT 密钥泄露尤其严重——任何人可伪造任意角色的 token（含 admin）。
#
#  变量名与 wms-agent 的 .env 保持一致（DB_*），三个服务共用一份。
# =====================================================================

# ---------- MySQL（后端 / Agent / sql 脚本 都用这几个）----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_wms

# ---------- JWT（仅后端用）----------
# ⚠️ 必须 32 字节以上（HS256 密钥长度下限）。
# 生成一个：openssl rand -base64 48
JWT_SECRET=

# ---------- 演示账号密码（仅 sql/tools 下的脚本用）----------
# 登录页展示的那批演示账号（admin / receiver / picker / supervisor）的密码。
WMS_DEMO_PASSWORD=

# ---------- LLM（可选，不配也能跑——会自动降级为规则桩）----------
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
